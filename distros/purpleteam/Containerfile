# syntax=buildkit/dockerfile:1

FROM debian:bookworm-slim AS builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv git \
        libxml2-dev libxslt1-dev libpq-dev libffi-dev && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/searxng && \
    /opt/searxng/bin/pip install --no-cache-dir searxng

FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 python3-lxml python3-redis libxml2-dev libxslt1-dev && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/searxng /opt/searxng

COPY settings.yml /etc/searxng/settings.yml
COPY limiter.toml /etc/searxng/limiter.toml

# Create non-root user
RUN groupadd -r searxng && useradd -r -g searxng -d /opt/searxng -s /usr/sbin/nologin searxng && \
    chown -R searxng:searxng /opt/searxng /etc/searxng && \
    mkdir -p /var/lib/searxng && chown searxng:searxng /var/lib/searxng

ENV PATH="/opt/searxng/bin:$PATH"
ENV SEARXNG_SETTINGS_PATH="/etc/searxng/settings.yml"
WORKDIR /opt/searxng

EXPOSE 8080

# Run as non-root user
USER searxng

LABEL org.opencontainers.image.source="https://github.com/searxng/searxng-distros"
LABEL org.opencontainers.image.title="SearXNG for Purple Team"
LABEL org.opencontainers.image.description="SearXNG pre-configured for security operations and threat intelligence"

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD ["/opt/searxng/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8080/health')"] || exit 1

CMD ["/opt/searxng/bin/python", "-m", "searx.webapp"]
